<%# The member layout: the top bar and a .page column. Sign-in and the dev sign-in use layouts/focus. %>
<!DOCTYPE html>

<html lang="en">
  <head>
    <title><%= [content_for(:title), "Stash"].compact_blank.join(" · ") %></title>
    <%= render "shared/head" %>
  </head>

  <body class="bg-quilt text-ink font-sans min-h-dvh flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <%= render "shared/staging_badge" %>
    <%= render "shared/topbar" %>

    <main id="main" class="flex-1" tabindex="-1">
      <%= yield %>
    </main>

    <footer class="page pt-0 pb-8 text-xs text-ink-faint flex flex-wrap gap-x-4 gap-y-1">
      <span>Stash is the Patchwork Labs archive.</span>
      <a href="https://github.com/patchworklabsorg/stash" class="link-quiet" target="_blank" rel="noopener noreferrer">Source</a>
      <a href="mailto:security@patchworklabs.org" class="link-quiet">Report a security issue</a>
    </footer>

    <div id="flash"><%= render "shared/flash" %></div>
  </body>
</html>
