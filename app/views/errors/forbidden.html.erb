<% content_for :title, "Not allowed" %>

<div class="page page-narrow">
  <div class="card">
    <div class="card-body space-y-4">
      <div class="flex items-center gap-3">
        <%= icon(:shield_off, size: 28, class: "text-ink-soft") %>

        <h1 class="page-title">403: Not allowed</h1>
      </div>

      <p class="text-ink-soft">You do not have a Stash role that allows this.</p>

      <p>
        Stash roles are <code class="code-chip">viewer</code>, <code class="code-chip">archivist</code> and
        <code class="code-chip">admin</code>. Ask a Weave admin for one.
      </p>

      <p><%= link_to "Back to sign-in", sign_in_path, class: "link" %></p>
    </div>
  </div>
</div>
