<% content_for :title, "Not allowed" %>

<div class="mx-auto mt-16 max-w-md">
  <section class="rounded-lg border border-stone-200 bg-white p-8 dark:border-stone-800 dark:bg-stone-900">
    <%= render "shared/brand_mark" %>

    <h1 class="mt-4 text-2xl font-semibold">403: Not allowed</h1>

    <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">You do not have a Stash role that allows this.</p>

    <p class="mt-4 text-sm">
      Stash roles are <code>viewer</code>, <code>archivist</code> and <code>admin</code>. Ask a Weave admin for one.
    </p>

    <p class="mt-6 text-sm"><%= link_to "Back to sign-in", sign_in_path, class: "underline" %></p>
  </section>
</div>
