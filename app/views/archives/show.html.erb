<% content_for :title, @archive.host %>

<p class="text-sm"><%= link_to "All archives", archives_path, class: "underline" %></p>

<div class="mt-2 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <h1 class="break-all text-xl font-semibold"><%= @archive.url %></h1>

    <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-stone-600 dark:text-stone-400">
      <%= status_badge(@archive.status) %>
      <span><%= @archive.kind %></span>
      <span>·</span>

      <code class="text-xs"><%= @archive.public_id %></code>
      <span>·</span>
      <span>archived <%= time_tag @archive.created_at, @archive.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></span>

      <% if @archive.requested_by_sub.present? %>
        <span>by <code class="text-xs"><%= @archive.requested_by_sub %></code></span>
      <% elsif @archive.client_id.present? %>
        <span>by app <code class="text-xs"><%= @archive.client_id %></code></span>
      <% end %>
    </p>

    <% if @archive.note.present? %>
      <p class="mt-2 text-sm"><%= @archive.note %></p>
    <% end %>

    <% if @archive.reference.present? %>
      <dl class="mt-2 flex flex-wrap gap-x-4 text-xs text-stone-600 dark:text-stone-400">
        <% @archive.reference.each do |key, value| %>
          <div>
            <dt class="inline font-medium"><%= key %>:</dt>
            <dd class="inline"><%= value.is_a?(String) ? value : value.to_json %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Open original", @archive.url, class: "rounded border border-stone-300 px-3 py-1.5 text-sm hover:bg-stone-100 dark:border-stone-700 dark:hover:bg-stone-800", rel: "noopener noreferrer nofollow", target: "_blank" %>

    <% if policy(@archive).rerun? && @archive.finished? %>
      <%= button_to "Run again", rerun_archive_path(@archive), class: "rounded border border-stone-300 px-3 py-1.5 text-sm hover:bg-stone-100 dark:border-stone-700 dark:hover:bg-stone-800", form: { data: { turbo_confirm: "Run every capture again? The old files are replaced." } } %>
    <% end %>
  </div>
</div>

<% unless @archive.finished? %>
  <p
    class="
      mt-4 rounded border border-sky-300 bg-sky-50 px-3 py-2 text-sm text-sky-900 dark:border-sky-800
      dark:bg-sky-950 dark:text-sky-100
    "
    role="status"
  >
    Captures are running. Reload this page in a moment.
  </p>
<% end %>

<section class="mt-6 space-y-4">
  <% @captures.each do |capture| %>
    <article class="rounded-lg border border-stone-200 bg-white p-4 dark:border-stone-800 dark:bg-stone-900">
      <header class="flex flex-wrap items-center gap-2">
        <h2 class="font-semibold"><%= capture.method_name %></h2>
        <%= status_badge(capture.status) %>

        <% if capture.duration %>
          <span class="text-xs text-stone-500"><%= capture.duration.round(1) %> s</span>
        <% end %>

        <code class="ml-auto text-xs text-stone-500"><%= capture.public_id %></code>
      </header>

      <% if capture.error.present? %>
        <p class="mt-2 break-words text-sm text-rose-700 dark:text-rose-300"><%= capture.error %></p>
      <% end %>

      <% if capture.artifacts.any? %>
        <ul class="mt-3 divide-y divide-stone-100 text-sm dark:divide-stone-800">
          <% capture.artifacts.each do |artifact| %>
            <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-1.5">
              <span class="w-20 text-xs uppercase tracking-wide text-stone-500"><%= artifact.role %></span>
              <%= link_to artifact.filename, artifact_path(artifact), class: "font-medium underline" %>
              <span class="text-stone-500"><%= artifact.content_type %></span>
              <span class="text-stone-500"><%= number_to_human_size(artifact.byte_size) %></span>

              <code class="ml-auto text-xs text-stone-400" title="<%= artifact.sha256 %>">sha256 <%= artifact.sha256.first(12) %></code>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% screenshot = capture.artifacts.find { |a| a.role == "screenshot" } %>

      <% if screenshot %>
        <%= link_to artifact_path(screenshot), class: "mt-3 block" do %>
          <%= image_tag artifact_path(screenshot), alt: "Screenshot of #{@archive.url}", class: "max-h-96 rounded border border-stone-200 object-cover object-top dark:border-stone-700", loading: "lazy" %>
        <% end %>
      <% end %>

      <% if capture.log.present? %>
        <details class="mt-3 text-xs">
          <summary class="cursor-pointer text-stone-600 dark:text-stone-400">Log</summary>

          <pre class="mt-2 max-h-64 overflow-auto rounded bg-stone-100 p-2 dark:bg-stone-950"><%= capture.log %></pre>
        </details>
      <% end %>
    </article>
  <% end %>
</section>

<% if policy(@archive).destroy? %>
  <section class="mt-10 rounded-lg border border-rose-200 p-4 dark:border-rose-900">
    <h2 class="font-semibold text-rose-800 dark:text-rose-200">Delete this archive</h2>

    <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">
      Deletes every capture and file. The audit log keeps the URL, your reason and the checksums.
    </p>

    <%= form_with url: archive_path(@archive), method: :delete, class: "mt-3 flex flex-wrap gap-2", data: { turbo_confirm: "Delete this archive and its files?" } do |form| %>
      <%= form.label :reason, "Reason", class: "sr-only" %>
      <%= form.text_field :reason, required: true, placeholder: "Why", class: "w-96 rounded border border-stone-300 px-3 py-1.5 text-sm dark:border-stone-700 dark:bg-stone-950" %>
      <%= form.submit "Delete", class: "rounded bg-rose-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-rose-800" %>
    <% end %>
  </section>
<% end %>
