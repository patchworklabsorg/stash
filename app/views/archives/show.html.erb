<% content_for :title, @archive.host %>

<div class="page space-y-6">
  <p class="text-sm">
    <%= link_to archives_path, class: "link-quiet inline-flex items-center gap-1" do %>
      <%= icon(:arrow_left) %>All archives
    <% end %>
  </p>

  <header class="page-header">
    <div class="min-w-0">
      <h1 class="page-title break-all text-xl"><%= @archive.url %></h1>

      <p class="page-lede flex flex-wrap items-center gap-2">
        <%= status_badge(@archive.status) %>
        <%= badge @archive.kind, tone: :teal %>

        <code class="code-chip"><%= @archive.public_id %></code>
        <span>archived <%= time_tag @archive.created_at, @archive.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></span>

        <% if @archive.requested_by_sub.present? %>
          <span>by <code class="code-chip"><%= @archive.requested_by_sub %></code></span>
        <% elsif @archive.client_id.present? %>
          <span>by app <code class="code-chip"><%= @archive.client_id %></code></span>
        <% end %>
      </p>

      <% if @archive.note.present? %>
        <p class="mt-2 text-sm text-ink"><%= @archive.note %></p>
      <% end %>

      <% if @archive.reference.present? %>
        <dl class="mt-2 flex flex-wrap gap-x-4 text-xs text-ink-soft">
          <% @archive.reference.each do |key, value| %>
            <div>
              <dt class="inline font-medium"><%= key %>:</dt>
              <dd class="inline"><%= value.is_a?(String) ? value : value.to_json %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>

    <div class="page-actions">
      <%= link_to @archive.url, class: "btn btn-secondary", rel: "noopener noreferrer nofollow", target: "_blank" do %>
        <%= icon(:external_link) %>Open original
      <% end %>

      <% if policy(@archive).rerun? && @archive.finished? %>
        <%= button_to rerun_archive_path(@archive), class: "btn btn-secondary", form: { data: { turbo_confirm: "Run every capture again? The old files are replaced." } } do %>
          <%= icon(:refresh_cw) %>Run again
        <% end %>
      <% end %>
    </div>
  </header>

  <% if (problem = @archive.problem) %>
    <div class="callout callout-danger" role="status">
      <%= icon(:triangle_alert, size: 18) %>

      <div class="callout-body">
        <p class="callout-title"><%= problem[:hint] %></p>

        <p class="break-words">
          <%= badge problem[:code].tr("_", " "), tone: :danger %> <%= problem[:method] %>: <%= problem[:message] %>
        </p>
      </div>
    </div>
  <% end %>

  <% unless @archive.finished? %>
    <div class="callout callout-info" role="status">
      <%= icon(:loader_circle, size: 18, class: "spinner") %>

      <div class="callout-body">
        <p class="callout-title">Captures are running</p>
        <p>Reload this page in a moment.</p>
      </div>
    </div>
  <% end %>

  <% @captures.each do |capture| %>
    <section class="card">
      <div class="card-header">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="card-title"><%= capture.method_name %></h2>
          <%= status_badge(capture.status) %>

          <% if capture.error_code.present? %>
            <%= badge capture.error_code.tr("_", " "), tone: :outline %>
          <% end %>

          <% if capture.duration %>
            <span class="text-xs text-ink-faint"><%= capture.duration.round(1) %> s</span>
          <% end %>
        </div>

        <code class="code-chip"><%= capture.public_id %></code>
      </div>

      <div class="card-body space-y-4">
        <% if capture.error.present? %>
          <div class="callout callout-danger">
            <%= icon(:circle_x, size: 18) %>

            <div class="callout-body break-words"><%= capture.error %></div>
          </div>
        <% end %>

        <% if capture.artifacts.any? %>
          <div class="record-list">
            <% capture.artifacts.each do |artifact| %>
              <div class="record">
                <div class="record-main">
                  <div class="record-title">
                    <%= badge artifact.role, tone: :sky %>
                    <%= link_to artifact.filename, artifact_path(artifact), class: "link" %>
                  </div>

                  <div class="record-meta">
                    <%= artifact.content_type %> · <%= number_to_human_size(artifact.byte_size) %> ·
                    <code class="mono" title="<%= artifact.sha256 %>">sha256 <%= artifact.sha256.first(12) %></code>
                  </div>
                </div>

                <div class="record-actions">
                  <%= link_to artifact_path(artifact), class: "btn btn-quiet btn-sm" do %>
                    <%= icon(:download) %>Download
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <% screenshot = capture.artifacts.find { |a| a.role == "screenshot" } %>

        <% if screenshot %>
          <%= link_to artifact_path(screenshot), class: "block" do %>
            <%= image_tag artifact_path(screenshot), alt: "Screenshot of #{@archive.url}", class: "max-h-96 w-full rounded-[var(--radius-control)] border border-hairline object-cover object-top", loading: "lazy" %>
          <% end %>
        <% end %>

        <% if capture.log.present? %>
          <details class="text-sm">
            <summary class="cursor-pointer text-ink-soft">Log</summary>

            <pre class="code-block mt-2 max-h-64 overflow-auto"><%= capture.log %></pre>
          </details>
        <% end %>

        <% if capture.error.blank? && capture.artifacts.empty? && capture.log.blank? %>
          <p class="text-sm text-ink-faint">Nothing stored yet.</p>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if policy(@archive).destroy? %>
    <section class="card">
      <div class="card-header">
        <div>
          <h2 class="card-title text-danger">Delete this archive</h2>

          <p class="card-lede">
            Deletes every capture and file. The audit log keeps the URL, your reason and the checksums.
          </p>
        </div>
      </div>

      <div class="card-body">
        <%= form_with url: archive_path(@archive), method: :delete, class: "flex flex-wrap items-end gap-2", data: { turbo_confirm: "Delete this archive and its files?" } do |form| %>
          <div class="field-group flex-1 min-w-64">
            <%= form.label :reason, class: "field-label" %>
            <%= form.text_field :reason, required: true, placeholder: "Why", class: "field" %>
          </div>

          <%= form.button type: :submit, class: "btn btn-danger" do %>
            <%= icon(:trash_2) %>Delete
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
