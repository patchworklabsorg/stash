<% content_for :title, "Archives" %>

<div class="page">
  <%= page_header "Archives", lede: "Everything Stash keeps, newest first." do %>
    <% if policy(Archive).create? %>
      <%= link_to new_archive_path, class: "btn btn-primary" do %>
        <%= icon(:plus) %>Archive a URL
      <% end %>
    <% end %>
  <% end %>

  <%= form_with url: archives_path, method: :get, class: "mb-6 flex flex-wrap items-center gap-2" do |form| %>
    <label class="search flex-1 min-w-56">
      <span class="sr-only">Search</span>
      <%= icon(:search) %>
      <%= form.search_field :q, value: @term, placeholder: "URL, host or note", class: "field", autocomplete: "off" %>
    </label>

    <%= form.button "Search", type: :submit, class: "btn btn-secondary" %>

    <% if @term.present? %>
      <%= link_to "Clear", archives_path, class: "btn btn-quiet" %>
    <% end %>
  <% end %>

  <% if @archives.empty? %>
    <div class="card">
      <% if @term.present? %>
        <%= empty_state "No archive matches “#{@term}”", body: "Try the host name, part of the URL or a word from the note.", icon: :search_x do %>
          <%= link_to "Show all", archives_path, class: "btn btn-secondary" %>
        <% end %>
      <% else %>
        <%= empty_state "Nothing is archived yet", body: "Patch apps send their submissions here. You can also archive a URL by hand.", icon: :archive do %>
          <% if policy(Archive).create? %>
            <%# The page header already has the primary "Archive a URL" button. %>
            <%= link_to "Archive a URL", new_archive_path, class: "btn btn-secondary" %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="card card-flush">
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>URL</th>
              <th>Kind</th>
              <th>Status</th>
              <th>Captures</th>
              <th>Archived</th>
            </tr>
          </thead>

          <tbody>
            <% @archives.each do |archive| %>
              <tr>
                <td class="max-w-md">
                  <%= link_to archive.url, archive, class: "link-quiet font-medium block truncate", title: archive.url %>

                  <% if archive.note.present? %>
                    <span class="table-sub truncate"><%= archive.note %></span>
                  <% end %>
                </td>

                <td><%= badge archive.kind, tone: :teal %></td>
                <td><%= status_badge(archive.status) %></td>
                <td class="text-ink-soft"><%= archive.captures.map(&:method_name).join(", ") %></td>

                <td class="whitespace-nowrap text-ink-soft">
                  <%= time_tag archive.created_at, archive.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-4 text-sm"><%= paginate @archives %></div>
  <% end %>
</div>
