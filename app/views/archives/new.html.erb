<% content_for :title, "Archive a URL" %>

<div class="page page-narrow">
  <%= page_header "Archive a URL",
    lede: "Paste a link to a web page, a GitHub repository, a Google Doc or Slides deck, a PDF, a video or a photo post. Stash picks the capture methods from the URL." %>

  <%= form_with model: @archive, class: "space-y-6" do |form| %>
    <%= form_errors(@archive) %>

    <div class="card">
      <div class="card-body form-grid">
        <div class="field-group">
          <%= form.label :url, "URL", class: "field-label" %>
          <%= form.url_field :url, required: true, placeholder: "https://", class: "field", autofocus: true %>
        </div>

        <div class="field-group">
          <%= form.label :note, class: "field-label" do %>
            Note <span class="optional">(optional)</span>
          <% end %>

          <%= form.text_area :note, rows: 3, maxlength: 2000, class: "field" %>

          <p class="field-hint">Why this URL is archived, for the people who open it later.</p>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <%= form.button type: :submit, class: "btn btn-primary" do %>
        <%= icon(:archive) %>Archive
      <% end %>

      <%= link_to "Cancel", archives_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
