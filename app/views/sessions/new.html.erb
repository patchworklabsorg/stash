<% content_for :title, "Sign in" %>

<div class="mx-auto mt-16 max-w-md">
  <section class="rounded-lg border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-800 dark:bg-stone-900">
    <%= render "shared/brand_mark" %>

    <h1 class="mt-4 text-2xl font-semibold">Sign in to Stash</h1>

    <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
      Stash is the Patchwork Labs archive: web pages, repositories, documents and media, kept as they were.
    </p>

    <% if Weave::Config.configured? %>
      <%= button_to "Sign in with Weave", auth_weave_path, class: "mt-6 w-full rounded bg-amber-600 px-4 py-2 font-medium text-white hover:bg-amber-700" %>
    <% else %>
      <p
        class="
          mt-6 rounded border border-rose-300 bg-rose-50 px-3 py-2 text-sm text-rose-900 dark:border-rose-800
          dark:bg-rose-950 dark:text-rose-100
        "
      >
        Weave sign-in is not set up. Set WEAVE_ISSUER, WEAVE_CLIENT_ID and WEAVE_CLIENT_SECRET.
      </p>
    <% end %>

    <% if Stash::AuthMode.dev? %>
      <p class="mt-4 text-center text-sm"><%= link_to "Dev sign-in", dev_sign_in_path, class: "underline" %></p>
    <% end %>
  </section>
</div>
