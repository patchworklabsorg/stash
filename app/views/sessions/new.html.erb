<% content_for :title, "Sign in" %>

<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound patch-tilt-l w-full max-w-md">
    <div class="quilt-binding"></div>

    <div class="p-8 sm:p-9 space-y-6">
      <div class="text-center space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>

        <h1 class="font-display text-2xl font-bold text-ink">Sign in to Stash</h1>

        <p class="text-ink-soft text-sm">
          The Patchwork Labs archive: web pages, repositories, documents and media, kept as they were.
        </p>
      </div>

      <% if Weave::Config.configured? %>
        <%# Turbo off: Turbo submits with fetch, and fetch cannot follow the redirect to Weave's origin. %>
      <%= button_to auth_weave_path, form: { data: { turbo: false } }, class: "btn btn-primary btn-lg btn-block" do %>
          <%= icon(:log_in) %>Sign in with Weave
        <% end %>
      <% else %>
        <div class="callout callout-danger" role="alert">
          <%= icon(:circle_x, size: 18) %>

          <div class="callout-body">
            <p class="callout-title">Weave sign-in is not set up</p>
            <p>Set WEAVE_ISSUER, WEAVE_CLIENT_ID and WEAVE_CLIENT_SECRET.</p>
          </div>
        </div>
      <% end %>

      <% if Stash::AuthMode.dev? %>
        <p class="text-center text-sm"><%= link_to "Dev sign-in", dev_sign_in_path, class: "link" %></p>
      <% end %>
    </div>
  </div>
</div>
