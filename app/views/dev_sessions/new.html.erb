<% content_for :title, "Dev sign-in" %>

<div class="min-h-full flex items-center justify-center p-6">
  <div class="patch patch-bound w-full max-w-lg">
    <div class="quilt-binding"></div>

    <div class="p-8 sm:p-9 space-y-6">
      <div class="space-y-2">
        <%= render "shared/wordmark", size: :lg, href: nil %>

        <h1 class="font-display text-2xl font-bold text-ink">Dev sign-in</h1>

        <p class="text-ink-soft text-sm">Development only. Pick a fake user. Nothing here talks to Weave.</p>
      </div>

      <section class="space-y-2">
        <h2 class="section-title">Presets</h2>

        <div class="record-list">
          <% DevSessionsController::PRESETS.each do |preset| %>
            <%= form_with url: dev_sign_in_path, method: :post, class: "record" do |form| %>
              <%= form.hidden_field :sub, value: preset[:sub] %>
              <%= form.hidden_field :name, value: preset[:name] %>

              <% preset[:roles].each do |role| %>
                <%= hidden_field_tag "roles[]", role, id: nil %>
              <% end %>

              <div class="record-main">
                <div class="record-title"><%= preset[:name] %></div>
                <div class="record-meta"><%= preset[:roles].presence&.join(", ") || "no roles" %></div>
              </div>

              <div class="record-actions">
                <%= form.button "Sign in", type: :submit, class: "btn btn-secondary btn-sm" %>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>

      <section class="space-y-2">
        <h2 class="section-title">Custom user</h2>

        <%= form_with url: dev_sign_in_path, method: :post, class: "space-y-4" do |form| %>
          <div class="field-group">
            <%= form.label :sub, "Weave sub (PWL id)", class: "field-label" %>
            <%= form.text_field :sub, value: "PWLDEVCUSTOM1", required: true, class: "field" %>
          </div>

          <div class="field-group">
            <%= form.label :name, class: "field-label" %>
            <%= form.text_field :name, value: "Custom User", class: "field" %>
          </div>

          <fieldset class="field-group">
            <legend class="field-label">Roles</legend>

            <div class="flex flex-wrap gap-4">
              <% Weave::Roles::ALL.each do |role| %>
                <label class="choice">
                  <%= check_box_tag "roles[]", role, false, id: "role_#{role}", class: "checkbox" %>
                  <span><%= role %></span>
                </label>
              <% end %>
            </div>
          </fieldset>

          <div class="form-actions">
            <%= form.button "Sign in", type: :submit, class: "btn btn-primary" %>
          </div>
        <% end %>
      </section>
    </div>
  </div>
</div>
